---
import Layout from '../../components/Layout.astro';
import { asset, bio, home, languages, skills, socials, timeline } from '../../data';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props;
const tr = lang === 'tr';
const index = tr ? 0 : 1;
const pdf = asset('burak-gokce-cv-' + lang + '.pdf');
---
<Layout lang={lang} title="CV · Burak Gökçe" description={bio[lang]} alternate={home(tr ? 'en' : 'tr') + 'cv/'}>
  <article class="shell detail cv">
    <header class="detail-header">
      <p class="eyebrow">DATA SCIENTIST</p><h1>Burak Gökçe</h1><p class="intro">{bio[lang]}</p>
      <div class="actions">
        <a class="button primary" href={pdf}>{tr ? 'PDF’yi görüntüle' : 'View PDF'}</a>
        <a class="button secondary" href={pdf} download>{tr ? 'PDF’yi indir' : 'Download PDF'}</a>
      </div>
      <div class="cv-socials">{Object.entries(socials).map(([label,url]) => <a href={url}>{label}</a>)}</div>
    </header>
    <div class="career">
      <section><h2>{tr ? 'Eğitim ve deneyim' : 'Education & experience'}</h2>
        <ol class="timeline">{timeline.map(item => <li><span class="source">{item.date[index]}</span><h3>{item.title[index]}</h3><strong>{item.org[index]}</strong>{item.description[index] && <p>{item.description[index]}</p>}</li>)}</ol>
      </section>
      <section><h2>{tr ? 'Teknik yetkinlikler' : 'Technical skills'}</h2>
        <div class="skill-list">{skills.map(group => <div class="panel skill"><h3>{group.name[index]}</h3><ul class="tags">{group.items.map(item => <li>{item}</li>)}</ul></div>)}</div>
      </section>
    </div>
  </article>
</Layout>
